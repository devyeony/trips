---
import type { TripMap } from '../data/types';
interface Props { map: TripMap; }
const { map } = Astro.props;

// Data the client script needs, serialised into the page.
const mapData = {
  mapId: map.mapId,
  dayColors: map.dayColors,
  stops: map.stops,
  hotels: map.hotels,
  routes: map.routes,
};
---
<section class="block" id={map.id}>
  <div class="blockhead">
    <span class="no">{map.no}</span>
    <h2>{map.title}</h2>
  </div>
  <div class="mapbox">
    <div id={map.mapId} role="application" aria-label={map.ariaLabel}></div>

    <div class="maplegend" id="maplegend" role="group" aria-label="날짜별로 보기">
      <button type="button" class="lg on" data-day="all" aria-pressed="true">전체</button>
      {map.legend.map((l) => (
        <button type="button" class="lg" data-day={l.d} aria-pressed="false">
          <b style={`background:${l.color}`}></b>{l.label}
        </button>
      ))}
      <span class="lg-stay"><b></b>숙소</span>
    </div>
    <ul class="mapnote">
      {map.note.map((line) => <li>{line}</li>)}
    </ul>

    <div class="dirlinks">
      {map.dirLinks.map((d) => (
        <a href={d.href} target="_blank" rel="noopener">
          <span>{d.day}</span>구글 지도로 경로 열기
        </a>
      ))}
    </div>
  </div>
</section>

<script type="application/json" id="mapdata" set:html={JSON.stringify(mapData)} />

<script>
  import L from 'leaflet';

  interface MapStop { d: string; n: string; ll: [number, number]; t: string; name: string; desc?: string; }
  interface MapHotel { d: string[]; ll: [number, number]; name: string; t: string; desc?: string; }
  interface MapRoute { d: string; color: string; pts: [number, number][]; }
  interface MapData {
    mapId: string;
    dayColors: Record<string, string>;
    stops: MapStop[];
    hotels: MapHotel[];
    routes: MapRoute[];
  }

  const el = document.getElementById('mapdata');
  const data: MapData | null = el ? JSON.parse(el.textContent || 'null') : null;
  const mapEl = data && document.getElementById(data.mapId);

  if (data && mapEl) {
    const map = L.map(data.mapId, { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap',
    }).addTo(map);

    const popup = (o: { t: string; name: string; desc?: string }) =>
      '<em>' + o.t + '</em><b>' + o.name + '</b>' + (o.desc ? o.desc : '');

    // One layer per day, so the legend can show a single day on its own.
    const layers: Record<string, L.LayerGroup> = {};
    const pts: Record<string, [number, number][]> = {};
    const layerFor = (d: string) => {
      if (!layers[d]) { layers[d] = L.layerGroup(); pts[d] = []; }
      return layers[d];
    };

    data.routes.forEach((r) => {
      L.polyline(r.pts, { color: r.color, weight: 3, opacity: 0.75, dashArray: '6 6' })
        .addTo(layerFor(r.d));
      pts[r.d].push(...r.pts);
    });

    data.stops.forEach((o) => {
      L.marker(o.ll, {
        icon: L.divIcon({
          className: '',
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          html: '<div class="pin" style="background:' + data.dayColors[o.d] + '">' + o.n + '</div>',
        }),
      })
        .addTo(layerFor(o.d))
        .bindPopup(popup(o));
      pts[o.d].push(o.ll);
    });

    // A stay shows on the days you actually sleep there: the Naha room is not
    // on the map while you're still in Onna.
    const stays = data.hotels.map((o) => ({
      days: o.d,
      ll: o.ll,
      marker: L.marker(o.ll, {
        icon: L.divIcon({ className: '', iconSize: [26, 26], iconAnchor: [13, 13], html: '<div class="pin sq">숙</div>' }),
        zIndexOffset: 500,
      }).bindPopup(popup(o)),
    }));

    const days = Object.keys(layers);
    const staysFor = (d: string) => stays.filter((s) => d === 'all' || s.days.includes(d));
    const boundsOf = (d: string) =>
      L.latLngBounds([
        ...(d === 'all' ? days.flatMap((k) => pts[k]) : pts[d] || []),
        ...staysFor(d).map((s) => s.ll),
      ]).pad(0.12);

    let current = 'all';
    let sized = mapEl.clientWidth > 0 && mapEl.clientHeight > 0;

    function show(day: string) {
      current = day;
      days.forEach((d) => {
        const on = day === 'all' || d === day;
        if (on) layers[d].addTo(map); else map.removeLayer(layers[d]);
      });
      stays.forEach((s) => {
        if (day === 'all' || s.days.includes(day)) s.marker.addTo(map);
        else map.removeLayer(s.marker);
      });
      document.querySelectorAll<HTMLButtonElement>('#maplegend .lg').forEach((b) => {
        const on = b.dataset.day === day;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      // Always set a view: a Leaflet map without one renders nothing at all,
      // not even tiles. While the panel is hidden this lands on the wrong
      // zoom, which the ResizeObserver below corrects once it has a size.
      const b = boundsOf(day);
      if (b.isValid()) map.fitBounds(b);
    }

    show('all');

    document.getElementById('maplegend')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-day]');
      // Tapping the day you're already on goes back to the whole route.
      if (b?.dataset.day) show(b.dataset.day === current ? 'all' : b.dataset.day);
    });

    // The map starts inside a hidden tab panel, so Leaflet measures it as 0x0
    // and fitBounds lands on the whole world. Fit once it really has a size;
    // after that only re-measure, so a resize keeps the reader's zoom.
    new ResizeObserver(() => {
      if (!(mapEl.clientWidth > 0 && mapEl.clientHeight > 0)) return;
      map.invalidateSize();
      if (!sized) { sized = true; map.fitBounds(boundsOf(current)); }
    }).observe(mapEl);
  } else if (mapEl) {
    mapEl.innerHTML =
      '<div style="padding:24px;font-size:14px;color:#5D7683">지도를 불러오지 못했습니다. 인터넷 연결을 확인하거나 아래 날짜별 버튼으로 구글 지도를 여세요.</div>';
  }
</script>
