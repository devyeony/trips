---
// The prep list. 42 rows is fine now that each one is collapsed - row count
// no longer costs page height. See docs/ui-redesign.md: these were nearly
// cut to 20 and it lost the parking, shopping and duty-free detail.
import type { Trip } from '../data/types';
import Accordion from './Accordion.astro';
interface Props { prep: Trip['prep']; }
const { prep } = Astro.props;
---
<section class="block" id={prep.id}>
  <div class="grouphead">
    <span class="no">{prep.no}</span>
    <h2>{prep.title}</h2>
    <p>{prep.rows.length}개 항목. 출발 전에 훑고, 현장에서 다시 찾아보는 곳입니다.</p>
  </div>
  {prep.rows.map((row) => (
    <Accordion k={row.k}>
      <div class="prose" set:html={row.v} />
    </Accordion>
  ))}
</section>
