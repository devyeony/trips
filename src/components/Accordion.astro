---
// A collapsed row: stays, the prep list, plan B, the route rationale.
// Heading text is deliberately large - this is the layer people scan.
import More from './More.astro';

interface Props { k: string; v?: string; }
const { k, v } = Astro.props;
---
<details class="acc">
  <summary class="acchead">
    <div class="k">{k}</div>
    {v && <div class="v">{v}</div>}
    <div class="meta"><More /></div>
  </summary>
  <div class="accbody">
    <slot />
  </div>
</details>
