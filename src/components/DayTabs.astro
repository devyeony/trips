---
// Date tabs. Four fixed columns, never a horizontal scroll - a tab you have to
// swipe to reach is a tab that doesn't exist for the reader we're building for.
import type { Day } from '../data/types';
interface Props { days: Day[]; }
const { days } = Astro.props;
---
<div class="daytabs" id="daytabs" role="tablist" aria-label="날짜 전환">
  {days.map((day, i) => (
    <button
      type="button"
      role="tab"
      data-day={day.id}
      aria-selected={i === 0 ? 'true' : 'false'}
      style={`--c:${day.colour}`}
    >
      <span class="dt-d">{day.tab.d}</span>
      <span class="dt-w">{day.tab.w}</span>
    </button>
  ))}
</div>
