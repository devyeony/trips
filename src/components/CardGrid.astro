---
// Stay / plan B / shopping, as accordions.
import type { BlockSection } from '../data/types';
import Accordion from './Accordion.astro';
interface Props { section: BlockSection; note?: string; }
const { section, note } = Astro.props;
---
<section class="block" id={section.id}>
  <div class="grouphead">
    <span class="no">{section.no}</span>
    <h2>{section.title}</h2>
    {note && <p>{note}</p>}
  </div>
  {section.cards.map((card) => (
    <Accordion k={card.title} v={card.kick}>
      {card.body && <div class="prose" set:html={card.body} />}
      {card.list && (
        <ul class="lst">
          {card.list.map((li) => <li set:html={li} />)}
        </ul>
      )}
    </Accordion>
  ))}
</section>
