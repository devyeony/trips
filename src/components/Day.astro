---
import type { Day } from '../data/types';
import Stop from './Stop.astro';

interface Props { day: Day; index: number; }
const { day, index } = Astro.props;

// Same words the stop cards use, so "부담" reads the same in both places.
const LOAD_WORD = { 1: '앉아서', 2: '걷기', 3: '물놀이·계단' } as const;
---
<section class:list={['day', { on: index === 0 }]} data-day={day.id} id={day.id}>
  <div class="dayhead">
    <span class="no">{day.no}</span>
    <h2>{day.title}</h2>
    <p class="date">{day.date}</p>
  </div>

  <div class="stats">
    {day.stats.map((s) => (
      <span><b>{s.k}</b>{s.load ? LOAD_WORD[s.load] : s.value}</span>
    ))}
  </div>

  <div class="tl">
    {day.timeline.map((entry) =>
      entry.kind === 'drive'
        ? <div class="drive"><span>{entry.label}</span></div>
        : <Stop stop={entry} />
    )}
  </div>
</section>
