---
import type { Day } from '../data/types';
import Stop from './Stop.astro';

interface Props { day: Day; index: number; }
const { day, index } = Astro.props;
---
<section class="day" data-day={day.id} id={day.id} hidden={index !== 0}>
  <div class="dayhead">
    <span class="no">{day.no}</span>
    <h2>{day.title}</h2>
    <p class="date">{day.date}</p>
  </div>

  <div class="stats">
    {day.stats.map((s) => (
      <span><b>{s.k}</b>{s.value}</span>
    ))}
  </div>

  <div class="tools">
    <button type="button" data-toggle={day.id}>전부 펼쳐 보기</button>
  </div>

  <div class="tl">
    {day.timeline.map((entry) =>
      entry.kind === 'drive'
        ? <div class="drive"><span>{entry.label}</span></div>
        : <Stop stop={entry} />
    )}
  </div>
</section>
