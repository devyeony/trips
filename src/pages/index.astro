---
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const trips = [
  {
    href: `${base}/okinawa-2026/`,
    eyebrow: '2026.09.20 – 09.23 · 3박 4일',
    title: '오키나와 여행',
    sub: '온나 2박 + 나하 1박. 4인 · 렌터카.',
  },
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>여행 기록</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" rel="stylesheet" />
</head>
<body>
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">Trips</p>
      <h1>여행 기록</h1>
    </div>
  </header>

  <main class="wrap">
    <div class="triplist">
      {trips.map((t) => (
        <a class="tripcard" href={t.href}>
          <span class="kick">{t.eyebrow}</span>
          <span class="name">{t.title}</span>
          <span class="sub">{t.sub}</span>
        </a>
      ))}
    </div>

    <footer>최종 정리 2026.09.10</footer>
  </main>
</body>
</html>
