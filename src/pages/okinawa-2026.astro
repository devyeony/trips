---
import Trip from '../layouts/Trip.astro';
import Hero from '../components/Hero.astro';
import RouteMap from '../components/RouteMap.astro';
import Day from '../components/Day.astro';
import CardGrid from '../components/CardGrid.astro';
import Checklist from '../components/Checklist.astro';
import { okinawa2026 as trip } from '../data/okinawa-2026';
---
<Trip trip={trip}>
  <Hero slot="hero" hero={trip.hero} />

  <div id="view-plan" class="view on" role="tabpanel" aria-labelledby="tab-plan">
    {trip.days.map((day, i) => <Day day={day} index={i} />)}
  </div>

  <div id="view-map" class="view" role="tabpanel" aria-labelledby="tab-map">
    <RouteMap map={trip.map} />
  </div>

  <div id="view-info" class="view" role="tabpanel" aria-labelledby="tab-info">
    <CardGrid section={trip.stay} />
    <Checklist prep={trip.prep} />
    <CardGrid section={trip.planB} />
  </div>
</Trip>
